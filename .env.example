# ===================================================================
# PrepWise Environment Variables
# Supabase PostgreSQL Configuration & Groq Cloud AI API
# ===================================================================

# --- AI Service Configuration (Groq Cloud API) ---
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.6-27b"
AI_SERVICE_URL="https://api.groq.com/openai/v1"

# --- Supabase PostgreSQL Database Credentials ---
# Supabase Project: https://vmcswtsywmbkvykepwpv.supabase.co
# Pooler Host (Region: ap-northeast-1):
DB_HOST="aws-0-ap-northeast-1.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USERNAME="postgres.vmcswtsywmbkvykepwpv"
DB_PASSWORD="your_supabase_db_password"

# Direct JDBC URL for Spring Boot (Supabase PostgreSQL SSL)
SPRING_DATASOURCE_URL="jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
SPRING_DATASOURCE_USERNAME="postgres.vmcswtsywmbkvykepwpv"
SPRING_DATASOURCE_PASSWORD="your_supabase_db_password"

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Supabase Project Metadata ---
SUPABASE_URL="https://vmcswtsywmbkvykepwpv.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# --- Spring Security & JWT Token Configuration ---
JWT_SECRET="404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970"
JWT_EXPIRATION=86400000

# --- Storage Configuration ---
FILE_STORAGE_TYPE="local"
FILE_STORAGE_PATH="/var/app/uploads"
FILE_STORAGE_MAX_SIZE=10485760

# --- Frontend & CORS Settings ---
VITE_API_BASE_URL="http://localhost:8080/api"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:80,http://localhost:5173"
