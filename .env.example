# ===================================================================
# PrepWise Environment Variables Template
# Copy this file to '.env' and populate with actual credentials.
# NEVER commit the real '.env' file to Git repositories!
# ===================================================================

# --- AI Service Configuration (Google Gemini) ---
GEMINI_API_KEY="your_gemini_api_key_here"
AI_GEMINI_API_KEY="your_gemini_api_key_here"
AI_MODEL="gemini-1.5-flash"
AI_FALLBACK_MODEL="gemini-2.0-flash"
AI_SERVICE_URL="https://generativelanguage.googleapis.com"

# --- Database Credentials & Compose Settings ---
# In Docker Compose, DB_HOST should be set to the service name: 'db'
DB_HOST="db"
DB_PORT=3306
DB_NAME="prepwise_db"
DB_USERNAME="prepwise_user"
DB_PASSWORD="prepwise_password_change_me"
DB_ROOT_PASSWORD="root_password_change_me"
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Spring Security & JWT Token Configuration ---
# Generate a 64-character hex string for production security
JWT_SECRET="404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970"
JWT_EXPIRATION=86400000

# --- Storage Configuration ---
FILE_STORAGE_TYPE="local"
FILE_STORAGE_PATH="/var/app/uploads"
FILE_STORAGE_MAX_SIZE=10485760

# --- Frontend & CORS Settings ---
VITE_API_BASE_URL="http://localhost:8080/api"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:80"
